# herdr configuration template (copied as-is to %APPDATA%\herdr\config.toml).
#
# herdr runs custom commands on Windows as `cmd.exe /d /c <command>`. cmd's /c
# quote rule strips the first and last quote when the string starts with a quote
# and contains more than two, so a quoted Git Bash path plus a quoted script path
# breaks when either path contains spaces. Each command therefore has exactly ONE
# quoted token (the launcher) plus a bare script name. install.ps1 writes the
# launcher %APPDATA%\herdr\run.cmd, which holds the detected Git Bash path and runs
# scripts\<name>. %APPDATA% is expanded by cmd, so spaces in it are fine too.
# Commands must stay single-quoted TOML literal strings (backslashes stay literal).
onboarding = false

[theme]
name = "tokyo-night"
auto_switch = false

[ui.toast]
delivery = "off"

[ui.sound]
enabled = true

[ui]
status_indicators = "dots"
prompt_new_workspace_name = true
prompt_new_tab_name = false

[keys]
new_workspace = ["prefix+shift+n", "ctrl+alt+n"]
new_tab = ["prefix+c", "ctrl+alt+c"]
next_tab = ["prefix+n", "ctrl+alt+l"]
previous_tab = "prefix+p"
next_workspace = "ctrl+alt+w"
close_tab = ["prefix+shift+x", "ctrl+alt+x"]

[[keys.command]]
key = "ctrl+alt+f"
type = "popup"
width = "60%"
height = "50%"
description = "Workspace finder"
command = '"%APPDATA%\herdr\run.cmd" workspace-finder.sh'

[[keys.command]]
key = "ctrl+alt+e"
type = "shell"
description = "Open or jump to nvim tab"
command = '"%APPDATA%\herdr\run.cmd" open-editor.sh'

[[keys.command]]
key = "ctrl+alt+g"
type = "popup"
width = "75%"
height = "75%"
description = "Shortcut cheat sheet"
command = '"%APPDATA%\herdr\run.cmd" shortcuts.sh'
